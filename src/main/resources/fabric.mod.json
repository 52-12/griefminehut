{
  "schemaVersion": 1,
  "id": "griefminehut",
  "version": "${version}",
  "name": "GriefMinehut",
  "description": "Joins a random Minehut server.",
  "authors": [
    "3upman"
  ],
  "contact": {
    "sources": "https://github.com/52-12/griefminehut"
  },
  "icon": "assets/griefminehut/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.griefminehut.addon.GriefMinehut"
    ]
  },
  "mixins": [
    "griefminehut.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${mc_version}"],
    "meteor-client": "*"
  }
}
